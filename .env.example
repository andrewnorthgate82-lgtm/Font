# ---------------------------------------------------------------------------
# الگوی متغیرهای محیطی اجرای self-hosted (Node 22 / SQLite).
#
# این فایل فقط الگو است و هیچ مقدار واقعی ندارد. فایل واقعی `.env` است که در
# Git نیست؛ روی ویندوز آن را با دستور زیر بسازید (خودش رمز و Secret می‌سازد):
#
#     node scripts/setup-env.mjs
#
# نکته: هیچ‌کدام از این مقادیر را در چت یا پیام‌رسان نفرستید.
# ---------------------------------------------------------------------------

# --- اتصال و مسیرها ---------------------------------------------------------
# بندر وب‌سرور. 8787 پیش‌فرض است.
SERVER_PORT=8787
# آدرس شنود. 0.0.0.0 یعنی از داخل شبکه هم در دسترس باشد (برای گوشی در خانه).
HOST=0.0.0.0
# پوشه پایگاه‌داده، رسانه و بکاپ. روی ویندوز همین حالت نسبی درست کار می‌کند.
DATA_DIR=data
# production باشد، اجرای MOCK_AI ممنوع می‌شود. برای تست محلی development.
NODE_ENV=production

# --- ورود به پنل (اجباری) ---------------------------------------------------
# حداقل ۱۰ کاراکتر.
OWNER_PASSWORD=
# حداقل ۳۲ کاراکتر. با دستور node scripts/setup-env.mjs خودکار ساخته می‌شود.
SESSION_SECRET=

# --- انتشار (مهم‌ترین سوئیچ ایمنی) ------------------------------------------
# dry_run یعنی هیچ پستی از این دستگاه بیرون نمی‌رود؛ فقط شبیه‌سازی.
# live فقط وقتی که واقعاً می‌خواهید منتشر شود و PUBLISH_ALLOWLIST پر است.
PUBLISH_GUARD_MODE=dry_run
# شناسه کانال/چت مجاز برای انتشار واقعی، با کاما.
PUBLISH_ALLOWLIST=
# مدت اعتبار تأیید دستی هر انتشار (ثانیه).
PUBLISH_APPROVAL_TTL_SEC=600

# --- تلگرام -----------------------------------------------------------------
# توکن همان بات موجود است؛ آن را تغییر ندهید و webhook آن را دست نزنید.
TG_BOT_TOKEN=
# چت‌آیدی شما، برای دریافت دکمه‌های تأیید گیت.
TG_OWNER_CHAT_ID=
# شناسه کانال مقصد (مثل @nasra_esfahan یا -100...). در تنظیمات پنل هم هست.
TELEGRAM_CHANNEL_ID=
# polling یعنی بدون نیاز به IP عمومی. روی لپ‌تاپ همین را روشن بگذارید.
TELEGRAM_POLLING=1
# اگر این ربات از قبل webhook دارد، تلگرام getUpdates نمی‌دهد. پیش‌فرض «دست نزن».
# فقط اگر مطمئنید همان ربات جای دیگری کار نمی‌کند، 1 بگذارید.
TELEGRAM_DELETE_WEBHOOK=0

# --- روشن کردن از راه دور (اختیاری) -----------------------------------------
# یک رشته طولانی. کد روزانه از آن ساخته می‌شود؛ کد دیروز کار نمی‌کند.
TG_WAKE_SECRET=
# دستوری که فقط پس از بررسی موفق کد اجرا می‌شود. خالی یعنی هیچ دستوری اجرا نمی‌شود.
WAKE_COMMAND=

# --- روبیکا -----------------------------------------------------------------
RUBIKA_BOT_TOKEN=

# --- هوش مصنوعی متن ---------------------------------------------------------
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
# نام مدل. خالی بگذارید = برنامه خودش از گوگل می‌پرسد کدام مدل‌ها موجودند.
# این تنها حالتی است که با بازنشسته شدن نام مدل‌ها خراب نمی‌شود.
AI_MODEL=

# --- تولید پوستر ------------------------------------------------------------
# تنها مقدار پشتیبانی‌شده: gemini. خالی بگذارید تا پوستر دستی بماند.
IMAGE_PROVIDER=
# کلید تصویر. فقط در همین فایل؛ نه در چت.
IMAGE_API_KEY=
IMAGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
IMAGE_MODELS=gemini-2.5-flash-image
IMAGE_TIMEOUT_MS=120000
IMAGE_JPEG_QUALITY=90

# --- رسانه ------------------------------------------------------------------
MEDIA_DIR=
MEDIA_URL_PATH=/media
MEDIA_KEEP=200
MEDIA_MAX_MB=300
# آدرس عمومی https که تلگرام/اینستاگرام بتوانند فایل را دانلود کنند.
# تا وقتی خالی است، تولید خودکار پوستر عمداً غیرفعال می‌ماند.
PUBLIC_BASE_URL=

# --- اتوپایلوت --------------------------------------------------------------
AUTOPILOT_ENABLED=1
AUTOPILOT_INTERVAL_MS=60000
# زمان‌بند انتشار؛ روی لپ‌تاپ روشن بماند.
SCHEDULER_ENABLED=1

# --- بکاپ -------------------------------------------------------------------
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
