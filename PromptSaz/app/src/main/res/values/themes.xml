<?xml version="1.0" encoding="utf-8"?>
<!--
  Branded splash (androidx.core:core-splashscreen): the gradient-family
  background + the prompt spark while the app cold-starts, then the plain
  NoActionBar theme. The full Material 3 theme is applied in code (ui/theme).
-->
<resources>
    <style name="Theme.PromptSaz.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/starting_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">250</item>
        <item name="postSplashScreenTheme">@style/Theme.PromptSaz</item>
    </style>

    <style name="Theme.PromptSaz" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/starting_background</item>
    </style>
</resources>
